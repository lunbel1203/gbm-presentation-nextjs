# ==========================================================================
# GBM CMS (Strapi) — variables de entorno
# Copia este archivo a `.env` y rellena los valores.
#
# Genera cada secreto con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# (APP_KEYS necesita 4 valores separados por comas)
# ==========================================================================

# --- Servidor ---
HOST=0.0.0.0
PORT=1337
# URL pública del panel (la que sirve Traefik). Administra ambos sitios (RD y USA).
PUBLIC_URL=https://admin.glaringmaintenance.com
# Dominio usado por Traefik en docker-compose
CMS_DOMAIN=admin.glaringmaintenance.com

# --- Secretos de Strapi (OBLIGATORIOS) ---
APP_KEYS=clave1==,clave2==,clave3==,clave4==
API_TOKEN_SALT=cambia-esto
ADMIN_JWT_SECRET=cambia-esto
TRANSFER_TOKEN_SALT=cambia-esto
ENCRYPTION_KEY=cambia-esto
JWT_SECRET=cambia-esto

# --- Base de datos (Postgres del docker-compose) ---
DATABASE_CLIENT=postgres
DATABASE_HOST=strapi-db
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=pon-una-password-fuerte
DATABASE_SSL=false

# --- Validación de accesos (compartido con las presentaciones Next.js) ---
# Debe coincidir EXACTAMENTE con VALIDATION_SECRET en cada presentación.
VALIDATION_SECRET=genera-un-secreto-largo-y-compartelo-con-nextjs

# --- Enriquecimiento de logs ---
# Geolocalización best-effort por IP (ip-api.com, gratuito). true/false
GEO_LOOKUP=true

# --- Notificaciones (FASE POSTERIOR con n8n) ---
# Déjalo vacío por ahora. Cuando se configure n8n, pon aquí la URL del webhook
# y se notificará el primer acceso de cada cliente.
NOTIFY_WEBHOOK_URL=
